<% content_for :title, "Tim Whitacre - Thoughts" %>
<% content_for :description, "My thoughts on software, design, and building things" %>

<section class="mb-24">
  <h2 class="heading-2">Thoughts</h2>

  <% if @posts.empty? %>
    <p class="text-center py-12" style="color: var(--base-text-secondary);">
      No posts yet. Check back soon!
    </p>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      <% @posts.each do |post| %>
        <article class="group">
          <%= link_to post_path(post.slug), class: "block" do %>
            <% if post.featured_image&.file&.attached? %>
              <div class="aspect-video mb-4 overflow-hidden rounded-lg">
                <img src="<%= post.featured_image.url %>"
                     alt="<%= post.title %>"
                     class="w-full h-full object-cover transition-transform group-hover:scale-105">
              </div>
            <% else %>
              <div class="aspect-video mb-4 rounded-lg flex items-center justify-center bg-gray-400 dark:bg-gray-600">
              </div>
            <% end %>

            <h3 class="group-hover:text-primary transition-colors" style="color: var(--base-text);">
              <%= post.title %>
            </h3>

            <% if post.abstract.present? %>
              <p class="text-sm line-clamp-3">
                <%= post.abstract %>
              </p>
            <% else %>
              <p class="text-sm line-clamp-3">
                <%= post.content.to_plain_text.first(100) %>...
              </p>
            <% end %>
          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>
</section>
