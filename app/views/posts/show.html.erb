<% content_for :title, "#{@post.title} - Tim Whitacre" %>
<% content_for :description, @post.abstract.presence || @post.title %>

<article class="max-w-4xl mx-auto">
  <% if @post.featured_image&.file&.attached? %>
    <img src="<%= @post.featured_image.url %>"
         alt="<%= @post.title %>"
         class="w-full h-96 object-cover rounded-2xl shadow-2xl mb-12">
  <% end %>

  <header class="mb-12">
    <div class="flex items-center gap-4 mb-6 text-sm" style="color: var(--base-text-tertiary);">
      <time datetime="<%= @post.published_date %>">
        <%= @post.published_date.strftime('%B %d, %Y') %>
      </time>
      <span>•</span>
      <span><%= @post.estimated_reading_time %> min read</span>
    </div>

    <h1 class="mb-6"><%= @post.title %></h1>

    <% if @post.abstract.present? %>
      <p class="text-xl mb-8 leading-relaxed" style="color: var(--base-text-secondary);">
        <%= @post.abstract %>
      </p>
      <hr class="border-t mb-12" style="border-color: var(--base-border-tertiary);">
    <% end %>
  </header>

  <div class="content">
    <%= @post.rendered_html.html_safe %>
  </div>

  <footer class="mt-16 pt-8 border-t" style="border-color: var(--base-border-tertiary);">
    <%= link_to "← Back to all thoughts", thoughts_path, class: "link" %>
  </footer>
</article>
