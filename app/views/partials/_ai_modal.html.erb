<div id="aiModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background-color: rgba(0, 0, 0, 0.7);">
  <div class="relative max-w-md w-full rounded-lg p-6 shadow-2xl post-sidebar border-1">
    <!-- Close button -->
    <button onclick="closeAiModal()" class="absolute top-4 right-4 text-2xl leading-none hover:opacity-70" style="color: var(--base-text-secondary);">
      &times;
    </button>

    <!-- Modal header -->
    <h3 class="text-xl font-semibold mb-6" style="color: var(--base-text);">Summarize with AI</h3>

    <!-- AI options -->
    <div class="space-y-4">
      <!-- ChatGPT section -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wide mb-2" style="color: var(--base-text-secondary);">ChatGPT</h4>
        <ul class="space-y-2 list-disc list-inside ml-4">
          <li class="list-item"><a href="https://chatgpt.com/?q=<%= CGI.escape("Summarize this article: #{request.original_url}") %>"
             target="_blank"
             rel="noopener noreferrer"
             class="text-sm rounded transition-colors hover:text-secondary dark:hover:text-primary text-black dark:text-white hover:underline">
            Summarize
          </a></li>
          <li><a href="https://chatgpt.com/?q=<%= CGI.escape("Explain this article like I'm 5: #{request.original_url}") %>"
             target="_blank"
             rel="noopener noreferrer"
             class="text-sm rounded transition-colors hover:text-secondary dark:hover:text-primary text-black dark:text-white hover:underline">
            Explain like I'm 5
          </a></li>
        </ul>
      </div>

      <!-- Claude section -->
      <div class="mt-8">
        <h4 class="text-sm font-semibold uppercase tracking-wide mb-2" style="color: var(--base-text-secondary);">Claude</h4>
        <ul class="space-y-2 list-disc list-inside ml-4">
          <li><a href="https://claude.ai/new?q=<%= CGI.escape("Summarize this article: #{request.original_url}") %>"
             target="_blank"
             rel="noopener noreferrer"
             class="text-sm rounded transition-colors hover:text-secondary dark:hover:text-primary text-black dark:text-white hover:underline">
            Summarize
          </a></li>
          <li><a href="https://claude.ai/new?q=<%= CGI.escape("Explain this article like I'm 5: #{request.original_url}") %>"
             target="_blank"
             rel="noopener noreferrer"
             class="text-sm rounded transition-colors hover:text-secondary dark:hover:text-primary text-black dark:text-white hover:underline">
            Explain like I'm 5
          </a></li>
        </ul>
      </div>
    </div>
  </div>
</div>