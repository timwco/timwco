<footer class="border-t" style="border-color: var(--base-border-tertiary);">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Left Column: About/Copyright -->
      <div class="space-y-4">
        <p class="text-sm font-semibold" style="color: var(--base-text);">
          Tim Whitacre
        </p>
        <p class="text-sm" style="color: var(--base-text-tertiary);">
          Turning ambitious ideas into reality
        </p>
        <p class="text-xs" style="color: var(--base-text-disabled);">
          © <%= Time.current.year %> Tim Whitacre
        </p>
      </div>

      <!-- Middle Column: Navigation Links -->
      <div class="space-y-4">
        <p class="text-sm font-semibold" style="color: var(--base-text);">
          Other Things 
        </p>
        <nav class="flex flex-col gap-2" aria-label="Footer navigation">
          <%= nav_link(music_path, "Music") %>
          <%= nav_link(links_path, "Links") %>
          <%= nav_link(tools_path, "Tools") %>
        </nav>
      </div>

      <!-- Right Column: Social & Theme Toggle -->
      <div class="space-y-6">
        <!-- Social Links -->
        <div class="space-y-4">
          <p class="text-sm font-semibold" style="color: var(--base-text);">
            Connect
          </p>
          <div class="flex gap-4">
            <a href="https://github.com/yourusername"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="GitHub"
               class="transition-opacity hover:opacity-70"
               style="color: var(--base-text-secondary);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
            </a>
            <a href="https://twitter.com/yourusername"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Twitter"
               class="transition-opacity hover:opacity-70"
               style="color: var(--base-text-secondary);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>
            <a href="https://linkedin.com/in/yourprofile"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="LinkedIn"
               class="transition-opacity hover:opacity-70"
               style="color: var(--base-text-secondary);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Theme Toggle -->
        <div class="space-y-4">
          <p class="text-sm font-semibold" style="color: var(--base-text);">
            Theme
          </p>
          <div class="flex gap-2" role="group" aria-label="Theme selection">
            <button id="theme-light"
                    class="p-1.5 rounded-lg transition-all"
                    style="background-color: var(--base-bg-base); color: var(--base-text-secondary);"
                    aria-label="Light mode"
                    title="Light mode">
              <!-- Sun Icon -->
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </button>
            <button id="theme-dark"
                    class="p-1.5 rounded-lg transition-all"
                    style="background-color: var(--base-bg-base); color: var(--base-text-secondary);"
                    aria-label="Dark mode"
                    title="Dark mode">
              <!-- Moon Icon -->
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </button>
            <button id="theme-system"
                    class="p-1.5 rounded-lg transition-all"
                    style="background-color: var(--base-bg-base); color: var(--base-text-secondary);"
                    aria-label="System theme"
                    title="System theme">
              <!-- Monitor/Computer Icon -->
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
