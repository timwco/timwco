<% 
  if field.model.name == "WishlistItem"
    options = Collection.wishlist.order(created_at: :desc).map { |collection| ["#{collection.name} (#{collection.collection_type.humanize})", collection.id] }
  elsif field.model.name == "Tool"
    options = Collection.tools.order(created_at: :desc).map { |collection| ["#{collection.name} (#{collection.collection_type.humanize})", collection.id] }
  else
    options = Collection.all.order(created_at: :desc).map { |collection| ["#{collection.name} (#{collection.collection_type.humanize})", collection.id] }
  end
%>

<%= form.select :collection_id, options, { include_blank: "No collection" }, { data: { controller: "select" } } %>