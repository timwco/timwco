<% content_for :title, "Tim Whitacre - Music" %>
<% content_for :description, "Some of my favorite music" %>

<section class="mb-24">
  <h2>My Favorite Music</h2>
  <div class="space-y-6">
    <p>The following albums I consider to be perfect in every way.</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 mt-8">
    <% @albums.each do |album| %>
      <% info = album.album_info %>
      <div class="flex flex-col gap-2">
        <a href="<%= info[:spotify_url] %>" target="_blank" rel="noopener noreferrer" class="block transition-opacity hover:opacity-70">
          <img src="<%= info[:image_url] %>" alt="<%= info[:title] %>" class="w-36 aspect-square rounded-lg shadow-lg">
        </a>
        <h4 class="font-semibold text-lg mt-2" style="color: var(--base-text);"><%= info[:title] %></h4>
        <p class="text-sm" style="color: var(--base-text-secondary);"><%= info[:artists] %></p>
        <p class="text-sm" style="color: var(--base-text-tertiary);"><%= info[:release_date].split('-').first %></p>
      </div>
    <% end %>
  </div>
</section>