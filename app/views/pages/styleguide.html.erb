<% content_for :title, "Tim Whitacre - Styleguide" %>
<% content_for :description, "Color palette and component showcase" %>

<div class="max-w-7xl mx-auto space-y-12 pb-20">
  <header class="mb-12">
    <h1 class="text-4xl font-bold mb-2" style="color: var(--base-text)">Design System Styleguide</h1>
    <p class="text-lg" style="color: var(--base-text-secondary)">Color palette and component showcase</p>
  </header>

  <!-- Primary Colors -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Primary Colors (Cyan/Teal)</h2>

    <div class="mb-8">
      <h3 class="text-xl font-semibold mb-4" style="color: var(--base-text-secondary)">Color Scale</h3>
      <div class="grid grid-cols-11 gap-2">
        <% [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950].each do |weight| %>
          <div class="text-center">
            <div class="h-20 rounded-lg mb-2" style="background-color: var(--color-primary-<%= weight %>)"></div>
            <span class="text-xs" style="color: var(--base-text-tertiary)"><%= weight %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Primary Buttons -->
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Buttons</h3>
        <div class="space-y-3">
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-primary); color: var(--text-on-primary); border: 1px solid var(--border-primary)">
            Primary Button
          </button>
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-primary-hover); color: var(--text-on-primary); border: 1px solid var(--border-primary-hover)">
            Primary Hover
          </button>
          <button class="px-6 py-3 rounded-lg font-medium transition-colors bg-transparent"
                  style="color: var(--text-primary); border: 1px solid var(--border-primary)">
            Primary Outline
          </button>
        </div>
      </div>

      <!-- Primary Text -->
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Text & Links</h3>
        <div class="space-y-3">
          <p style="color: var(--text-primary)">Primary text color</p>
          <p style="color: var(--text-primary-hover)">Primary text hover</p>
          <a href="#" class="underline" style="color: var(--text-primary)">Primary link</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Secondary Colors -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Secondary Colors (Pink/Red)</h2>

    <div class="mb-8">
      <h3 class="text-xl font-semibold mb-4" style="color: var(--base-text-secondary)">Color Scale</h3>
      <div class="grid grid-cols-11 gap-2">
        <% [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950].each do |weight| %>
          <div class="text-center">
            <div class="h-20 rounded-lg mb-2" style="background-color: var(--color-secondary-<%= weight %>)"></div>
            <span class="text-xs" style="color: var(--base-text-tertiary)"><%= weight %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Buttons</h3>
        <div class="space-y-3">
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-secondary); color: var(--text-on-secondary); border: 1px solid var(--border-secondary)">
            Secondary Button
          </button>
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-secondary-hover); color: var(--text-on-secondary-hover); border: 1px solid var(--border-secondary)">
            Secondary Hover
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Danger -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Danger (Red)</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Buttons</h3>
        <div class="space-y-3">
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-danger); color: var(--text-on-danger); border: 1px solid var(--border-danger)">
            Danger Button
          </button>
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-danger-hover); color: var(--text-on-danger); border: 1px solid var(--border-danger)">
            Danger Hover
          </button>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Alert</h3>
        <div class="p-4 rounded-lg flex items-start gap-3" style="background-color: var(--bg-danger-secondary)">
          <svg class="w-5 h-5 mt-0.5" style="color: var(--icon-on-danger-secondary)" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
          <div>
            <p class="font-semibold" style="color: var(--text-on-danger-secondary)">Error occurred</p>
            <p class="text-sm" style="color: var(--text-on-danger-secondary)">Something went wrong with your request.</p>
          </div>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Text</h3>
        <p style="color: var(--text-danger)">Danger text color for errors</p>
      </div>
    </div>
  </section>

  <!-- Success -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Success (Green)</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Buttons</h3>
        <div class="space-y-3">
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-success); color: var(--text-on-success); border: 1px solid var(--border-success)">
            Success Button
          </button>
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-success-hover); color: var(--text-on-success); border: 1px solid var(--border-success)">
            Success Hover
          </button>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Alert</h3>
        <div class="p-4 rounded-lg flex items-start gap-3" style="background-color: var(--bg-success-secondary)">
          <svg class="w-5 h-5 mt-0.5" style="color: var(--icon-on-success-secondary)" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <div>
            <p class="font-semibold" style="color: var(--text-on-success-secondary)">Success!</p>
            <p class="text-sm" style="color: var(--text-on-success-secondary)">Your changes have been saved.</p>
          </div>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Text</h3>
        <p style="color: var(--text-success)">Success text color</p>
      </div>
    </div>
  </section>

  <!-- Info -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Info (Primary)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Alert</h3>
        <div class="p-4 rounded-lg flex items-start gap-3" style="background-color: var(--bg-info-secondary)">
          <svg class="w-5 h-5 mt-0.5" style="color: var(--icon-on-info-secondary)" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div>
            <p class="font-semibold" style="color: var(--text-on-info-secondary)">Information</p>
            <p class="text-sm" style="color: var(--text-on-info-secondary)">Here's some helpful information for you.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Warning -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Warning (Yellow)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Alert</h3>
        <div class="p-4 rounded-lg flex items-start gap-3" style="background-color: var(--bg-warning-secondary)">
          <svg class="w-5 h-5 mt-0.5" style="color: var(--icon-on-warning-secondary)" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <div>
            <p class="font-semibold" style="color: var(--text-on-warning-secondary)">Warning</p>
            <p class="text-sm" style="color: var(--text-on-warning-secondary)">Please review this before continuing.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Accent -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Accent (Orange)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Buttons</h3>
        <div class="space-y-3">
          <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                  style="background-color: var(--bg-accent); color: var(--text-on-accent); border: 1px solid var(--border-accent)">
            Accent Button
          </button>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Text</h3>
        <p style="color: var(--text-accent)">Accent text for highlights</p>
      </div>
    </div>
  </section>

  <!-- Light/Dark -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Light & Dark Variants</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Light</h3>
        <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                style="background-color: var(--bg-light); color: var(--text-on-light); border: 1px solid var(--border-light)">
          Light Button
        </button>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Dark</h3>
        <button class="px-6 py-3 rounded-lg font-medium transition-colors"
                style="background-color: var(--bg-dark); color: var(--text-on-dark); border: 1px solid var(--border-dark)">
          Dark Button
        </button>
      </div>
    </div>
  </section>

  <!-- Disabled -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Disabled States</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Buttons</h3>
        <div class="space-y-3">
          <button class="px-6 py-3 rounded-lg font-medium cursor-not-allowed"
                  style="background-color: var(--bg-disabled); color: var(--text-on-disabled-selected); border: 1px solid var(--border-disabled)"
                  disabled>
            Disabled Button
          </button>
          <button class="px-6 py-3 rounded-lg font-medium cursor-not-allowed"
                  style="background-color: var(--bg-disabled-secondary); color: var(--text-on-disabled-selected); border: 1px solid var(--border-disabled)"
                  disabled>
            Disabled Secondary
          </button>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4" style="color: var(--base-text-secondary)">Text & Icons</h3>
        <div class="space-y-3">
          <p style="color: var(--base-text-disabled)">Disabled text</p>
          <svg class="w-6 h-6" style="color: var(--icon-disabled)" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 000 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Base Colors -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Base System Colors</h2>

    <div class="mb-8">
      <h3 class="text-xl font-semibold mb-4" style="color: var(--base-text-secondary)">Text Hierarchy</h3>
      <div class="space-y-2">
        <p class="text-xl" style="color: var(--base-text)">Primary text - Main content</p>
        <p class="text-lg" style="color: var(--base-text-secondary)">Secondary text - Supporting content</p>
        <p style="color: var(--base-text-tertiary)">Tertiary text - Less important</p>
        <p style="color: var(--base-text-disabled)">Disabled text - Inactive content</p>
      </div>
    </div>

    <div class="mb-8">
      <h3 class="text-xl font-semibold mb-4" style="color: var(--base-text-secondary)">Background Layers</h3>
      <div class="space-y-3">
        <div class="p-4 rounded-lg" style="background-color: var(--base-bg-lowest)">
          <p style="color: var(--base-text)">Lowest - Base layer</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--base-bg-low)">
          <p style="color: var(--base-text)">Low - Content background</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--base-bg-base)">
          <p style="color: var(--base-text)">Base - Default surfaces</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--base-bg-high)">
          <p style="color: var(--base-text)">High - Elevated surfaces</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--base-bg-highest)">
          <p style="color: var(--base-text)">Highest - Modals/overlays</p>
        </div>
      </div>
    </div>

    <div class="mb-8">
      <h3 class="text-xl font-semibold mb-4" style="color: var(--base-text-secondary)">Interactive States</h3>
      <div class="space-y-3">
        <div class="p-4 rounded-lg transition-colors cursor-pointer" style="background-color: var(--base-bg-base)">
          <p style="color: var(--base-text)">Default state</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--base-bg-hover)">
          <p style="color: var(--base-text)">Hover state (primary color)</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--base-bg-selected); border: 2px solid var(--base-border-focus)">
          <p style="color: var(--base-text)">Selected & focused</p>
        </div>
      </div>
    </div>

    <div class="mb-8">
      <h3 class="text-xl font-semibold mb-4" style="color: var(--base-text-secondary)">Borders</h3>
      <div class="space-y-3">
        <div class="p-4 rounded-lg" style="border: 2px solid var(--base-border-primary)">
          <p style="color: var(--base-text)">Primary border</p>
        </div>
        <div class="p-4 rounded-lg" style="border: 2px solid var(--base-border-secondary)">
          <p style="color: var(--base-text)">Secondary border</p>
        </div>
        <div class="p-4 rounded-lg" style="border: 2px solid var(--base-border-tertiary)">
          <p style="color: var(--base-text)">Tertiary border</p>
        </div>
        <div class="p-4 rounded-lg" style="border: 2px solid var(--base-border-focus)">
          <p style="color: var(--base-text)">Focus border (primary color)</p>
        </div>
      </div>
    </div>

    <div>
      <h3 class="text-xl font-semibold mb-4" style="color: var(--base-text-secondary)">Tooltip</h3>
      <div class="inline-block px-3 py-2 rounded shadow-lg" style="background-color: var(--base-bg-tooltip)">
        <p class="text-sm" style="color: var(--base-text-on-tooltip)">This is a tooltip</p>
      </div>
    </div>
  </section>

  <!-- Form Elements -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Form Elements</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label class="block mb-2 font-medium" style="color: var(--base-text-secondary)">Text Input</label>
          <input type="text"
                 class="w-full px-4 py-2 rounded-lg"
                 style="background-color: var(--base-bg-base); color: var(--base-text); border: 2px solid var(--base-border-secondary)"
                 placeholder="Enter text...">
        </div>
        <div>
          <label class="block mb-2 font-medium" style="color: var(--base-text-secondary)">Text Input (Focus)</label>
          <input type="text"
                 class="w-full px-4 py-2 rounded-lg"
                 style="background-color: var(--base-bg-base); color: var(--base-text); border: 2px solid var(--base-border-focus)"
                 placeholder="Focused state">
        </div>
      </div>
      <div class="space-y-4">
        <div>
          <label class="block mb-2 font-medium" style="color: var(--base-text-secondary)">Select Dropdown</label>
          <select class="w-full px-4 py-2 rounded-lg"
                  style="background-color: var(--base-bg-base); color: var(--base-text); border: 2px solid var(--base-border-secondary)">
            <option>Option 1</option>
            <option>Option 2</option>
            <option>Option 3</option>
          </select>
        </div>
        <div>
          <label class="block mb-2 font-medium" style="color: var(--base-text-secondary)">Textarea</label>
          <textarea class="w-full px-4 py-2 rounded-lg"
                    style="background-color: var(--base-bg-base); color: var(--base-text); border: 2px solid var(--base-border-secondary)"
                    rows="3"
                    placeholder="Enter text..."></textarea>
        </div>
      </div>
    </div>
  </section>

  <!-- Cards -->
  <section>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--base-text)">Cards & Containers</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-lg" style="background-color: var(--base-bg-base); border: 1px solid var(--base-border-secondary)">
        <h3 class="text-lg font-semibold mb-2" style="color: var(--base-text)">Card Title</h3>
        <p class="mb-4" style="color: var(--base-text-secondary)">This is a basic card with base background and border.</p>
        <button class="px-4 py-2 rounded-lg text-sm font-medium"
                style="background-color: var(--bg-primary); color: var(--text-on-primary)">
          Action
        </button>
      </div>
      <div class="p-6 rounded-lg" style="background-color: var(--base-bg-high); border: 1px solid var(--base-border-primary)">
        <h3 class="text-lg font-semibold mb-2" style="color: var(--base-text)">Elevated Card</h3>
        <p class="mb-4" style="color: var(--base-text-secondary)">This card uses a higher background level.</p>
        <button class="px-4 py-2 rounded-lg text-sm font-medium"
                style="background-color: var(--bg-secondary); color: var(--text-on-secondary)">
          Action
        </button>
      </div>
      <div class="p-6 rounded-lg" style="background-color: var(--base-bg-selected); border: 2px solid var(--base-border-focus)">
        <h3 class="text-lg font-semibold mb-2" style="color: var(--base-text)">Selected Card</h3>
        <p class="mb-4" style="color: var(--base-text-secondary)">This card appears selected/focused.</p>
        <button class="px-4 py-2 rounded-lg text-sm font-medium"
                style="background-color: var(--bg-accent); color: var(--text-on-accent)">
          Action
        </button>
      </div>
    </div>
  </section>
</div>
