<% content_for :title, "Cool Guy" %>
<% content_for :description, "Creative developer crafting modern web experiences with clean code and thoughtful design." %>

<div class="min-h-screen">
  <div class="max-w-2xl mx-auto px-6 py-20 md:py-32">

    <!-- Hero Section -->
    <section class="mb-32">
      <div class="mb-8">
        <h1>Tim Whitacre</h1>
        <div class="h-1 w-24 mb-6 bg-primary"></div>
      </div>

      <p class="larger mb-6">
        Creative developer crafting modern web experiences with clean code and thoughtful design.
      </p>

      <p class="text-content-light">
        I build digital products that balance aesthetics with functionality,
        focusing on performance and user experience.
      </p>
    </section>

    <!-- About Section -->
    <section class="mb-32">
      <h2>About</h2>

      <div class="space-y-6">
        <p>
          With over a decade of experience in web development, I specialize in building
          scalable applications using modern technologies. My approach combines technical
          expertise with a keen eye for design.
        </p>

        <p>
          I believe in writing clean, maintainable code and creating interfaces that
          feel natural to use. Every project is an opportunity to solve problems
          creatively and push boundaries.
        </p>
      </div>
    </section>

    <!-- Work/Projects Section -->
    <section class="mb-32">
      <h2>Selected Work</h2>

      <div class="space-y-12">
        <!-- Project 1 -->
        <article class="group cursor-pointer">
          <div class="mb-4">
            <h3>Project Alpha</h3>
            <p class="text-sm text-primary">
              2024 • Web Application
            </p>
          </div>
          <p class="text-base text-content-light">
            A modern platform for team collaboration featuring real-time updates,
            seamless file sharing, and intelligent workflow automation.
          </p>
          <div class="flex flex-wrap gap-2 mt-4">
            <span class="badge">
              Rails
            </span>
            <span class="badge">
              TailwindCSS
            </span>
            <span class="badge">
              JavaScript
            </span>
          </div>
        </article>

        <!-- Project 2 -->
        <article class="group cursor-pointer">
          <div class="mb-4">
            <h3>Design System Pro</h3>
            <p class="text-sm text-primary">
              2023 • Design System
            </p>
          </div>
          <p class="text-base text-content-light">
            Comprehensive design system and component library for enterprise
            applications, ensuring consistency across multiple products.
          </p>
          <div class="flex flex-wrap gap-2 mt-4">
            <span class="badge">
              React
            </span>
            <span class="badge">
              TypeScript
            </span>
            <span class="badge">
              Storybook
            </span>
          </div>
        </article>

        <!-- Project 3 -->
        <article class="group cursor-pointer">
          <div class="mb-4">
            <h3>Analytics Dashboard</h3>
            <p class="text-sm text-primary">
              2023 • Data Visualization
            </p>
          </div>
          <p class="text-base text-content-light">
            Real-time analytics platform with custom visualizations, helping
            teams make data-driven decisions with confidence.
          </p>
          <div class="flex flex-wrap gap-2 mt-4">
            <span class="badge">
              Vue.js
            </span>
            <span class="badge">
              D3.js
            </span>
            <span class="badge">
              Node.js
            </span>
          </div>
        </article>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="mb-20">
      <h2>Get In Touch</h2>

      <div class="space-y-6">
        <p class="text-xl">
          I'm always interested in hearing about new projects and opportunities.
          Whether you have a question or just want to say hi, feel free to reach out.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <a href="mailto:hello@example.com" class="button">
            Send an Email
          </a>
          <a href="https://twitter.com/yourusername" class="button-alternate">
            Follow on Twitter
          </a>
        </div>

        <div class="pt-8 flex gap-6" style="color: var(--color-gray-500);">
          <a href="https://github.com/yourusername"
             class="hover:opacity-70 transition-opacity">
            GitHub
          </a>
          <a href="https://linkedin.com/in/yourprofile"
             class="hover:opacity-70 transition-opacity">
            LinkedIn
          </a>
          <a href="https://dribbble.com/yourprofile"
             class="hover:opacity-70 transition-opacity">
            Dribbble
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="pt-12 border-t" style="border-color: var(--color-gray-900); color: var(--base-text-disabled);">
      <p class="text-sm">
        © <%= Time.current.year %> Tim Whitacre. All rights reserved.
      </p>
    </footer>

  </div>
</div>
